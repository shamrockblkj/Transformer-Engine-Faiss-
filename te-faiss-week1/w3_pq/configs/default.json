{
  "schema_version": 1,
  "experiment": "w3_pq_single_layer",
  "written": "2026-11-26",
  "timezone_note": "Asia/Shanghai",
  "model": {
    "path": "/data/models/Meta-Llama-3-8B",
    "type": "meta-llama-3-8b-hf",
    "local_files_only": true,
    "exclude": ["original/*"],
    "torch_dtype": "bfloat16"
  },
  "environment": {
    "conda_env": "torch2.8_cuda12.8",
    "forbidden_conda_env": "torch2.14_cuda13.0",
    "python": "3.12.0",
    "torch": "2.8.0+cu128",
    "faiss_cpu": "1.16.0",
    "transformers": "5.24.1",
    "accelerate": "1.16.0",
    "forbid_gpu_faiss": true,
    "forbid_packages": [
      "autoawq",
      "awq",
      "auto-gptq",
      "gptqmodel",
      "aqlm"
    ],
    "refuse_gpu_names": ["Tesla P4", "Tesla-P4", "4090 D", "4090D"],
    "expected_gpu_substr": "4090",
    "required_compute_capability": [8, 9],
    "min_memory_mib": 24000,
    "max_memory_mib": 25000,
    "expected_memory_mib": 24564
  },
  "runtime": {
    "device": "cuda:0"
  },
  "layers": [0, 16],
  "roles": ["gate", "up", "down"],
  "pq": {
    "nbits": 8,
    "dsub": 4,
    "seed": 1234,
    "niter": 20,
    "nredo": 1,
    "verbose": true,
    "max_points_per_centroid": 256,
    "omp_num_threads": 8,
    "note": "gate/up: (d,M)=(4096,1024); down: (14336,3584)。本周按单层单角色单独训练，不做每 4 层共享码本。"
  },
  "column_scale": {
    "enabled": true,
    "alpha": 1.0,
    "median_normalize": true,
    "clamp_min": 0.05,
    "clamp_max": 20.0,
    "note": "方案 2.1 固定前置，不列入本周四组消融。单层实验显式应用 s，不把 s^{-1} 折进 RMSNorm gamma。"
  },
  "rotation": {
    "enabled": true,
    "kind": "fwht",
    "down_block_size": 2048,
    "sign_seeds": {
      "gate_up": 20261126,
      "down": 20261127
    },
    "note": "方案 2.2 固定前置。gate 与 up 共用同一旋转；down 做 7 段 2048 维分块 FWHT。质心预乘 1/sqrt(d) 再存 FP16 的部署打包不在本周范围，重建在 FP32 数学域完成。"
  },
  "row_rms": {
    "eps": 1e-12,
    "store_dtype": "float16",
    "note": "B2.3：在旋转域对每行除以 RMS，行尺度按 FP16 存储并按该存储值乘回。"
  },
  "sigma_weight": {
    "eig_floor": 1e-8,
    "accumulate_dtype": "float64",
    "note": "B2.5：旋转域每个 4 维子空间的二阶矩 Σ=E[xx^T]（不减均值）。权重子向量右乘 Σ^{1/2} 后交给 Faiss，质心再右乘 Σ^{-1/2} 变回。"
  },
  "calibration": {
    "path": "/data/te-faiss-week1/calib/w3_calib_seed42.jsonl",
    "text_key": "text",
    "n_sequences": 32,
    "max_length": 512,
    "seed": 42,
    "batch_size": 4,
    "note": "第 1 周默认小规模本地切片，保证可复现。完整方案口径为 512 条 × 2048 token，语料本地就绪后只改这四个字段即可。校准必须与正式评测集隔离。本脚本不会下载语料。"
  },
  "evaluation": {
    "path": "/data/te-faiss-week1/calib/w3_eval_seed43.jsonl",
    "text_key": "text",
    "n_sequences": 16,
    "max_length": 512,
    "seed": 43,
    "batch_size": 4,
    "fallback_to_calib": false,
    "kl_temperature": 1.0,
    "kl_unit": "nats_per_token",
    "compute_layer_output_mse": true,
    "compute_ffn_output_mse": true,
    "compute_single_layer_kl": true,
    "note": "线性/FFN 输出 MSE 默认在校准激活上计算。Σ 分组（sigma / row_rms_sigma）的该项指标偏乐观，不得当契约数；持出激活上的输出 MSE 待追加。单层 KL 必须走评测语料；默认不回退到校准集。缺失则失败得清楚并把 KL 标为待准备，不中止重建 MSE。"
  },
  "groups": [
    {
      "id": "plain",
      "row_rms": false,
      "sigma_weight": false,
      "title": "无行 RMS、无 Σ 加权"
    },
    {
      "id": "row_rms",
      "row_rms": true,
      "sigma_weight": false,
      "title": "有行 RMS、无 Σ 加权"
    },
    {
      "id": "sigma",
      "row_rms": false,
      "sigma_weight": true,
      "title": "无行 RMS、有 Σ 加权"
    },
    {
      "id": "row_rms_sigma",
      "row_rms": true,
      "sigma_weight": true,
      "title": "有行 RMS、有 Σ 加权"
    }
  ],
  "output": {
    "results_dir": "results",
    "logs_dir": "logs"
  }
}
